# ==============================================================================
# Sarcasm Detection Microservice - Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Machine Learning model paths & parameters
SARCASM_MODEL_PATH=models/sarcasm_model_final
SARCASM_DATA_PATH=data/Sarcasm_Headlines_Dataset_v2.json
SARCASM_MAX_LENGTH=128

# Security & CORS (comma-separated list of allowed origins)
# Example for production: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*
